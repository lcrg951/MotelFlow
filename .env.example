# Copia este archivo como .env y completa los valores reales.
# Genera una clave con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 solo en desarrollo local; en producción debe ser 0
FLASK_DEBUG=0
# Pon 1 si la app corre detrás de un proxy HTTPS (Render, Heroku, Nginx)
CONFIAR_PROXY=0
# Puedes usar DATABASE_URL o las variables DB_* por separado
DATABASE_URL=
DB_NAME=neondb
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# Clave para cifrar los datos de nómina. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Debe ser LA MISMA en tu computador y en Render. Si se pierde, la nómina guardada no se puede leer.
NOMINA_CLAVE=
